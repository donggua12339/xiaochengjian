# 小城笺 · 编辑器统一配置
# 所有子项目继承此配置,子目录可用 .editorconfig 覆盖

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.py]
indent_size = 4

[*.kt]
indent_size = 4

[*.java]
indent_size = 4

[*.c]
indent_size = 4

[*.h]
indent_size = 4

[Makefile]
indent_style = tab

[Dockerfile]
indent_size = 4

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 2

[*.toml]
indent_size = 2

[*.gradle.kts]
indent_size = 4
